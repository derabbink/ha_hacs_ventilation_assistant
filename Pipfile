[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[requires]
python_version = "3.14"

[dev-packages]
aiohttp = ">=3.0"
defusedxml = ">=0.7"
homeassistant = "*"
jinja2 = ">=3.1"
pillow = ">=12.2.0"
pytest = "*"
ruff = "*"
ty = "*"

[scripts]
lint = "ruff check ."
typecheck = "ty check"
test = "pytest"
compile = "python -m compileall custom_components tests"
hacs-validate = "sh scripts/hacs-validate"
hassfest = "sh scripts/hassfest"
ci = "sh scripts/local-ci"
